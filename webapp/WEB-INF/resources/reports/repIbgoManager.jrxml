<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="repWeekProductPlan" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e7684bbc-9451-49e2-a652-4a2ef56ca359">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="imageURL" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ROW_NUMBER()OVER(ORDER BY ORDERT.ORD_CODE) AS ROW_NUM, ORDERT.ORD_CODE, PRODUCT.PROD_CODE,
			   ORD_DATE, CORP.CORP_NAME, PRODUCT.PROD_NAME,
               PRODUCT.PROD_NO, PRODUCT.PROD_GYU, PRODUCT.PROD_JAI, TECHIN.TECH_TE,
               ORDERT.ORD_LOT, ORDERT.ORD_GYU, STR(ORDERT.ORD_AMNT, 16, 1) AS ORD_AMNT,
               ORDERT.ORD_DANG, ORDERT.ORD_MON, ORDERT.ORD_DANW,
               ORDERT.ORD_SU, CASE WHEN [ORDERT].[ORD_T02] = '1' THEN 'O' ELSE 'X' END AS ORD_T02,
               CASE WHEN [ORDERT].[ORD_T01] = '1' THEN 'O' ELSE 'X' END AS ORD_T01, IPTEST.ITST_WP
		FROM  ORDERT
			INNER JOIN PRODUCT ON ORDERT.PROD_CODE = PRODUCT.PROD_CODE
			INNER JOIN CORP ON PRODUCT.CORP_CODE = CORP.CORP_CODE
			INNER JOIN IPTEST ON ORDERT.ORD_CODE = IPTEST.ORD_CODE
			LEFT OUTER JOIN TECHIN ON PRODUCT.TECH_NO = TECHIN.TECH_NO]]>
	</queryString>
	<field name="ROW_NUM" class="java.lang.Long"/>
	<field name="ORD_CODE" class="java.math.BigDecimal"/>
	<field name="PROD_CODE" class="java.math.BigDecimal"/>
	<field name="ORD_DATE" class="java.sql.Timestamp"/>
	<field name="CORP_NAME" class="java.lang.String"/>
	<field name="PROD_NAME" class="java.lang.String"/>
	<field name="PROD_NO" class="java.lang.String"/>
	<field name="PROD_GYU" class="java.lang.String"/>
	<field name="PROD_JAI" class="java.lang.String"/>
	<field name="TECH_TE" class="java.lang.String"/>
	<field name="ORD_LOT" class="java.lang.String"/>
	<field name="ORD_GYU" class="java.lang.String"/>
	<field name="ORD_AMNT" class="java.lang.String"/>
	<field name="ORD_DANG" class="java.lang.Double"/>
	<field name="ORD_MON" class="java.lang.Double"/>
	<field name="ORD_DANW" class="java.lang.String"/>
	<field name="ORD_SU" class="java.math.BigDecimal"/>
	<field name="ORD_T02" class="java.lang.String"/>
	<field name="ORD_T01" class="java.lang.String"/>
	<field name="ITST_WP" class="java.lang.String"/>
	<variable name="MyCorp" class="java.lang.String">
		<variableExpression><![CDATA["태경열처리"]]></variableExpression>
	</variable>
	<variable name="Sum_Mon" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{ORD_MON}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="Sum_Su" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{ORD_SU}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
