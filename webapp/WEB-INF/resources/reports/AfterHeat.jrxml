<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AfterHeat" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="59f828d3-3559-4a8c-a863-50fe45ccae09">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[SELECT LEFT(CONVERT(varchar, ORDERT.ORD_DATE, 120), 10) AS OrdDate,
       ORDERT.ORD_DATE,
       CORP.CORP_NAME,
       PRODUCT.PROD_NAME,
       ORDERT.ORD_LOT,
       ORDERT.ORD_SU,
       ORDERT.ORD_GYU,
       IPTEST.ITST_WP,
       IPTEST.ITST_P
  FROM ORDERT AS ORDERT
   INNER JOIN PRODUCT AS PRODUCT
       ON ORDERT.PROD_CODE = PRODUCT.PROD_CODE
   INNER JOIN CORP AS CORP
       ON PRODUCT.CORP_CODE = CORP.CORP_CODE
   INNER JOIN TECHIN AS TECHIN
       ON PRODUCT.TECH_NO = TECHIN.TECH_NO
   LEFT OUTER JOIN IPTEST AS IPTEST
       ON ORDERT.ORD_CODE = IPTEST.ORD_CODE
 WHERE ORDERT.ORD_DATE BETWEEN '2013-08-06' AND '2013-08-08'
       AND ORDERT.ORD_CODE in ( '130806002' )
ORDER BY "ORDERT"."ORD_DATE",
       "CORP"."CORP_NAME",
       "PRODUCT"."PROD_NAME"]]>
	</queryString>
	<field name="OrdDate" class="java.lang.String"/>
	<field name="ORD_DATE" class="java.sql.Timestamp"/>
	<field name="CORP_NAME" class="java.lang.String"/>
	<field name="PROD_NAME" class="java.lang.String"/>
	<field name="ORD_LOT" class="java.lang.String"/>
	<field name="ORD_SU" class="java.math.BigDecimal"/>
	<field name="ORD_GYU" class="java.lang.String"/>
	<field name="ITST_WP" class="java.lang.String"/>
	<field name="ITST_P" class="java.lang.String"/>
	<background>
